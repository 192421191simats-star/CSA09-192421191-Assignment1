digraph G { rankdir=BT; graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, splines=ortho];
node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9];
subgraph cluster_model { label="parking.model"; style=rounded; color="#7A8CA8";
Vehicle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;abstract&raquo;</I></TD></TR><TR><TD BORDER="0"><I>Vehicle</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MINUTES_PER_DAY = 1440<BR ALIGN="LEFT"/>+ DAILY_CAP_HOURS = 8<BR ALIGN="LEFT"/>- regNo : String {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># Vehicle(regNo)<BR ALIGN="LEFT"/>+ getRegNo() : String {final}<BR ALIGN="LEFT"/># ratePerHour() : int {abstract}<BR ALIGN="LEFT"/># graceMinutes() : int<BR ALIGN="LEFT"/>+ needsChargingSlot() : boolean<BR ALIGN="LEFT"/>+ calculateFee(minutes : int) : double<BR ALIGN="LEFT"/>+ calculateFee(in, out : LocalDateTime) : double<BR ALIGN="LEFT"/>+ equals(o) / hashCode() {final}<BR ALIGN="LEFT"/>+ toString() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TwoWheeler [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>TwoWheeler</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># ratePerHour() = 10<BR ALIGN="LEFT"/># graceMinutes() = 30<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Car [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Car</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># ratePerHour() = 30<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ElectricCar [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ElectricCar</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ needsChargingSlot() = true<BR ALIGN="LEFT"/>+ chargingFee(kWh) : double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Chargeable [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF6E0">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;interface&raquo;</I></TD></TR><TR><TD BORDER="0"><I>Chargeable</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">RATE_PER_KWH = 12.0<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ chargingFee(kWh) : double<BR ALIGN="LEFT"/>+ checkKWh(kWh) {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;abstract&raquo;</I></TD></TR><TR><TD BORDER="0"><I>User</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hasFreeParking() : boolean {abstract}<BR ALIGN="LEFT"/>+ category() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Student [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Student</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- monthlyPass : boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hasFreeParking()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Staff [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Staff</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- monthlyPass : boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hasFreeParking()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Visitor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Visitor</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hasFreeParking() = false<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ParkingSlot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ParkingSlot</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- floor, number : int {final}<BR ALIGN="LEFT"/>- chargingPoint : boolean {final}<BR ALIGN="LEFT"/>- occupant : Vehicle<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isFree() : boolean<BR ALIGN="LEFT"/>+ park(v : Vehicle)<BR ALIGN="LEFT"/>+ vacate() : Vehicle<BR ALIGN="LEFT"/>+ label() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ParkingTicket [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ParkingTicket</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- nextNumber : long {static}<BR ALIGN="LEFT"/>- ticketNo : long {final}<BR ALIGN="LEFT"/>- entryTime : LocalDateTime<BR ALIGN="LEFT"/>- exitTime : LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ close(exit : LocalDateTime)<BR ALIGN="LEFT"/>+ peekNextNumber() : long {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Receipt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;record&raquo;</I></TD></TR><TR><TD BORDER="0"><B>Receipt</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">ticketNo, regNo, minutes,<BR ALIGN="LEFT"/>parkingFee, chargingFee<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ total() : double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_service { label="parking.service"; style=rounded; color="#7A8CA8";
ParkingLot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ParkingLot</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- floors : ParkingSlot[][]  (jagged)<BR ALIGN="LEFT"/>- active : ParkingTicket[]<BR ALIGN="LEFT"/>- activeCount : int<BR ALIGN="LEFT"/>- totalCollection : double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enter(v, u, at) : ParkingTicket<BR ALIGN="LEFT"/>+ exit(regNo, at, kWh) : Receipt<BR ALIGN="LEFT"/>+ release(floor, slot) : boolean<BR ALIGN="LEFT"/>- allocate(v) : ParkingSlot<BR ALIGN="LEFT"/>- findActive(regNo) : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
VehicleFactory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;utility&raquo;</I></TD></TR><TR><TD BORDER="0"><B>VehicleFactory</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(type, regNo) : Vehicle {static}<BR ALIGN="LEFT"/>+ createUser(cat, id, pass) : User {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ParkingException [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ParkingException</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ParkingException(msg)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_app { label="parking.app"; style=rounded; color="#7A8CA8";
ParkingApp [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ParkingApp</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ main(args) {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TestRunner [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>TestRunner</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ main(args) {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
TwoWheeler -> Vehicle [arrowhead=empty]; Car -> Vehicle [arrowhead=empty]; ElectricCar -> Car [arrowhead=empty]; ElectricCar -> Chargeable [arrowhead=empty, style=dashed];
Student -> User [arrowhead=empty]; Staff -> User [arrowhead=empty]; Visitor -> User [arrowhead=empty];
ParkingLot -> ParkingSlot [arrowhead=none, arrowtail=diamond, dir=both, xlabel="1..*"];
ParkingLot -> ParkingTicket [arrowhead=none, arrowtail=odiamond, dir=both, xlabel="0..*"];
ParkingTicket -> Vehicle [arrowhead=vee]; ParkingTicket -> User [arrowhead=vee]; ParkingTicket -> ParkingSlot [arrowhead=vee];
ParkingLot -> Receipt [style=dashed, arrowhead=vee, xlabel="creates"];
VehicleFactory -> Vehicle [style=dashed, arrowhead=vee, xlabel="creates"];
ParkingApp -> ParkingLot [style=dashed, arrowhead=vee]; ParkingApp -> VehicleFactory [style=dashed, arrowhead=vee]; TestRunner -> ParkingLot [style=dashed, arrowhead=vee];
ParkingLot -> ParkingException [style=dashed, arrowhead=vee, xlabel="throws"];
label="Task 11 - Class diagram of the implemented system"; labelloc=t;
}
