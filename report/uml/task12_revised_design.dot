digraph G { rankdir=BT; graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, splines=ortho];
node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9];
subgraph cluster_model { label="parking.model"; style=rounded; color="#7A8CA8";
Vehicle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;abstract&raquo;</I></TD></TR><TR><TD BORDER="0"><I>Vehicle</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- regNo : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># ratePerHour() : int {abstract}<BR ALIGN="LEFT"/>+ calculateFee(minutes) : double<BR ALIGN="LEFT"/>+ calculateFee(in, out) : double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TwoWheeler [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>TwoWheeler</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(unchanged)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Car [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Car</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(unchanged)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ElectricCar [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ElectricCar</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(unchanged)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Chargeable [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF6E0">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;interface&raquo;</I></TD></TR><TR><TD BORDER="0"><I>Chargeable</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ chargingFee(kWh)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EBike [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>EBike  [NEW]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- RULE : FlatFeeRule(20) {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateFee(minutes) : double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DeliveryVan [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>DeliveryVan  [NEW]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- RULE : PeakHourRule {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateFee(in, out) : double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;abstract&raquo;</I></TD></TR><TR><TD BORDER="0"><I>User  [MODIFIED]</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String<BR ALIGN="LEFT"/>- pass : Pass  (0..1)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setPass(p : Pass)<BR ALIGN="LEFT"/># mayHold(p : Pass) : boolean {abstract}<BR ALIGN="LEFT"/>+ hasFreeParking(day : LocalDate) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Student [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Student  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mayHold(p) : MonthlyPass only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Staff [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Staff  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mayHold(p) : MonthlyPass only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Visitor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Visitor  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mayHold(p) : OneDayPass only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Pass [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;interface&raquo;</I></TD></TR><TR><TD BORDER="0"><I>Pass  [NEW]</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ coversParking(day) : boolean<BR ALIGN="LEFT"/>+ price() : double<BR ALIGN="LEFT"/>+ label() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MonthlyPass [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>MonthlyPass  [NEW]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- month : YearMonth<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ coversParking(day)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
OneDayPass [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>OneDayPass  [NEW]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PRICE = 100<BR ALIGN="LEFT"/>- day : LocalDate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ coversParking(day)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_pricing { label="parking.pricing  [NEW package]"; style=rounded; color="#4C9A4C";
PricingRule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;interface&raquo;</I></TD></TR><TR><TD BORDER="0"><I>PricingRule</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fee(in, out : LocalDateTime) : double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FlatFeeRule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>FlatFeeRule</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- amount : double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fee(in, out)<BR ALIGN="LEFT"/>+ feeFor(minutes)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PeakHourRule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>PeakHourRule</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- baseRate, multiplier : int<BR ALIGN="LEFT"/>- peakStart, peakEnd : LocalTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fee(in, out)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_service { label="parking.service"; style=rounded; color="#7A8CA8";
ParkingLot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ParkingLot  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- floors : ParkingSlot[][]  (jagged, unchanged)<BR ALIGN="LEFT"/>- passSales : double  (new)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enter(...)  counts pass sale<BR ALIGN="LEFT"/>+ exit(...)  uses hasFreeParking(day)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
VehicleFactory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>VehicleFactory  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- REGISTRY : Map&lt;String, Function&lt;String,Vehicle&gt;&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(type, ctor) {static}<BR ALIGN="LEFT"/>+ create(type, regNo) {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
TwoWheeler -> Vehicle [arrowhead=empty]; Car -> Vehicle [arrowhead=empty]; ElectricCar -> Car [arrowhead=empty]; ElectricCar -> Chargeable [arrowhead=empty, style=dashed];
EBike -> Vehicle [arrowhead=empty]; DeliveryVan -> Vehicle [arrowhead=empty];
Student -> User [arrowhead=empty]; Staff -> User [arrowhead=empty]; Visitor -> User [arrowhead=empty];
MonthlyPass -> Pass [arrowhead=empty, style=dashed]; OneDayPass -> Pass [arrowhead=empty, style=dashed];
FlatFeeRule -> PricingRule [arrowhead=empty, style=dashed]; PeakHourRule -> PricingRule [arrowhead=empty, style=dashed];
User -> Pass [arrowhead=odiamond, dir=back, arrowtail=odiamond, xlabel="has-a 0..1"];
EBike -> FlatFeeRule [arrowhead=vee, xlabel="uses"]; DeliveryVan -> PeakHourRule [arrowhead=vee, xlabel="uses"];
VehicleFactory -> Vehicle [style=dashed, arrowhead=vee, xlabel="creates"];
ParkingLot -> User [style=dashed, arrowhead=vee];
label="Task 12 - Revised design (green = new, yellow = modified, white/blue = unchanged)"; labelloc=t;
}
