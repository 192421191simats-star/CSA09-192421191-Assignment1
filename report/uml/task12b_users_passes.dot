digraph G { rankdir=BT; graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, splines=ortho];
node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9];
User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;abstract&raquo;</I></TD></TR><TR><TD BORDER="0"><I>User  [MODIFIED]</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String<BR ALIGN="LEFT"/>- pass : Pass  (0..1)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setPass(p : Pass)<BR ALIGN="LEFT"/># mayHold(p : Pass) : boolean {abstract}<BR ALIGN="LEFT"/>+ hasFreeParking(day : LocalDate) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Student [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Student  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mayHold(p) : MonthlyPass only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Staff [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Staff  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mayHold(p) : MonthlyPass only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Visitor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>Visitor  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mayHold(p) : OneDayPass only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Pass [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><I>&laquo;interface&raquo;</I></TD></TR><TR><TD BORDER="0"><I>Pass  [NEW]</I></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ coversParking(day) : boolean<BR ALIGN="LEFT"/>+ price() : double<BR ALIGN="LEFT"/>+ label() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MonthlyPass [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>MonthlyPass  [NEW]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- month : YearMonth<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ coversParking(day)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
OneDayPass [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F6E3">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>OneDayPass  [NEW]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PRICE = 100<BR ALIGN="LEFT"/>- day : LocalDate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ coversParking(day)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ParkingLot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF1CC">
<TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"><B>ParkingLot  [MODIFIED]</B></TD></TR></TABLE></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- floors : ParkingSlot[][]  (jagged, unchanged)<BR ALIGN="LEFT"/>- passSales : double  (new)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enter(...)  counts pass sale<BR ALIGN="LEFT"/>+ exit(...)  uses hasFreeParking(day)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Student -> User [arrowhead=empty]; Staff -> User [arrowhead=empty]; Visitor -> User [arrowhead=empty]; MonthlyPass -> Pass [arrowhead=empty, style=dashed]; OneDayPass -> Pass [arrowhead=empty, style=dashed];
User -> Pass [arrowhead=vee, arrowtail=odiamond, dir=both, xlabel="has-a 0..1"];
ParkingLot -> User [style=dashed, arrowhead=vee, xlabel="hasFreeParking(day)"];
label="Task 12 (b) - Users and passes (green = new, yellow = modified)"; labelloc=t;
}
